# Browser public configuration only. Never prefix server secrets with VITE_.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Worker runtime secrets/config: set through Cloudflare, not bundled frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=terminal-transfer-staging
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# JSON map of version => base64 encoded 32 random bytes. Keep previous versions for decrypting existing codes.
SHARE_CODE_KEYS={"v1":""}
SHARE_CODE_ACTIVE_KEY=v1
APP_ORIGIN=http://127.0.0.1:5173
# Keep false until real R2 browser signature size enforcement integration passes.
DIRECT_UPLOAD_VERIFIED=false
